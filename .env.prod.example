# =============================================================
# AMS — Production environment template
# Copy to .env.prod and set real secrets. Never commit .env.prod.
# =============================================================
APP_ENV=production
APP_VERSION=0.1.0

POSTGRES_DB=ams
POSTGRES_USER=ams
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Generate: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET
JWT_EXPIRES_IN=8h

# Initial sysadmin password (only user seeded in production — change after first login)
SEED_PASSWORD=CHANGE_ME_SYSADMIN_PASSWORD
